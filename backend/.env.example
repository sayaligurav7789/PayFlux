NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_orchestration
REDIS_URL=redis://localhost:6379

# Percentage chance (0-100) the mock gateway randomly fails a request
MOCK_GATEWAY_FAILURE_RATE=15
# Simulated network latency range in ms
MOCK_GATEWAY_MIN_LATENCY_MS=100
MOCK_GATEWAY_MAX_LATENCY_MS=600
